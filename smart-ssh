#!/bin/bash

# smart-ssh - Local network-based SSH connection script
# Automatically chooses between regular public key auth (home) and security key auth (away)
# Usage: smart-ssh <hostname>
# Example: smart-ssh hostname

VERSION="1.0.0"

# Configuration file path (XDG Base Directory compliant)
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/smart-ssh"
CONFIG_FILE="$CONFIG_DIR/config"

# Default configuration values
DEFAULT_HOME_NETWORK="192.168.1.0/24"
DEFAULT_HOME_GATEWAY_MAC=""
DEFAULT_SECURITY_KEY_PATH="$HOME/.ssh/id_ed25519_sk"
DEFAULT_TAILSCALE_AS_HOME="true"
# The macOS App Store build of Tailscale ships its CLI inside the bundle and
# installs no PATH symlink; look there before giving up on the daemon
DEFAULT_TAILSCALE_CLI_BUNDLE_PATH="/Applications/Tailscale.app/Contents/MacOS/Tailscale"
DEFAULT_LOG_LEVEL="info"
DEFAULT_OIDC_ENABLED="false"
DEFAULT_OIDC_ISSUER=""
DEFAULT_OIDC_CLIENT_ID=""
DEFAULT_OIDC_CLIENT_SECRET=""
DEFAULT_OIDC_SCOPES="openid email"
DEFAULT_OIDC_CA_URL=""
DEFAULT_OIDC_CA_PROVISIONER="oidc"
DEFAULT_OIDC_CA_MODE="api"
DEFAULT_OIDC_CERT_LIFETIME="3600"
DEFAULT_OIDC_CERT_DIR="$HOME/.ssh/oidc-certs"
DEFAULT_OIDC_AUTH_MODE="auto"

# Trim leading and trailing whitespace without spawning external tools.
trim_whitespace() {
    local value="$1"
    value="${value#"${value%%[![:space:]]*}"}"
    value="${value%"${value##*[![:space:]]}"}"
    printf '%s\n' "$value"
}

# Load configuration from file if it exists
load_config() {
    if [ -f "$CONFIG_FILE" ]; then
        # Source the config file in a safe manner
        while IFS='=' read -r key value; do
            # Skip comments and empty lines
            [[ "$key" =~ ^#.*$ ]] && continue
            [[ -z "$key" ]] && continue

            # Remove leading/trailing whitespace
            key=$(trim_whitespace "$key")
            value=$(trim_whitespace "$value")

            # Remove quotes from value if present
            value="${value%\"}"
            value="${value#\"}"
            value="${value%\'}"
            value="${value#\'}"

            case "$key" in
                HOME_NETWORK)
                    CONFIG_HOME_NETWORK="$value"
                    ;;
                HOME_GATEWAY_MAC)
                    CONFIG_HOME_GATEWAY_MAC="$value"
                    ;;
                SECURITY_KEY_PATH)
                    CONFIG_SECURITY_KEY_PATH="$value"
                    ;;
                TAILSCALE_AS_HOME)
                    CONFIG_TAILSCALE_AS_HOME="$value"
                    ;;
                TAILSCALE_CLI_BUNDLE_PATH)
                    CONFIG_TAILSCALE_CLI_BUNDLE_PATH="$value"
                    ;;
                LOG_LEVEL)
                    CONFIG_LOG_LEVEL="$value"
                    ;;
                OIDC_ENABLED) CONFIG_OIDC_ENABLED="$value" ;;
                OIDC_ISSUER) CONFIG_OIDC_ISSUER="$value" ;;
                OIDC_CLIENT_ID) CONFIG_OIDC_CLIENT_ID="$value" ;;
                OIDC_CLIENT_SECRET) CONFIG_OIDC_CLIENT_SECRET="$value" ;;
                OIDC_SCOPES) CONFIG_OIDC_SCOPES="$value" ;;
                OIDC_CA_URL) CONFIG_OIDC_CA_URL="$value" ;;
                OIDC_CA_PROVISIONER) CONFIG_OIDC_CA_PROVISIONER="$value" ;;
                OIDC_CA_MODE) CONFIG_OIDC_CA_MODE="$value" ;;
                OIDC_CERT_LIFETIME) CONFIG_OIDC_CERT_LIFETIME="$value" ;;
                OIDC_CERT_DIR) CONFIG_OIDC_CERT_DIR="$value" ;;
                OIDC_AUTH_MODE) CONFIG_OIDC_AUTH_MODE="$value" ;;
            esac
        done < "$CONFIG_FILE"
    fi
}

# Load configuration
load_config

# Print SSH host aliases from ~/.ssh/config and supported Include files.
# Wildcard Host patterns are skipped because smart-ssh expects concrete aliases.
_list_ssh_hosts_from_file() {
    local config_file="$1"

    [ -f "$config_file" ] || return 0

    local line trimmed directive directive_lower rest include
    while IFS= read -r line || [ -n "$line" ]; do
        trimmed=$(trim_whitespace "$line")
        [[ -z "$trimmed" ]] && continue
        [[ "$trimmed" == \#* ]] && continue

        directive="${trimmed%%[[:space:]]*}"
        rest=""
        if [ "$directive" != "$trimmed" ]; then
            rest=$(trim_whitespace "${trimmed#"$directive"}")
        fi

        directive_lower=$(printf '%s' "$directive" | tr '[:upper:]' '[:lower:]')

        case "$directive_lower" in
            host)
                local host_alias
                for host_alias in $rest; do
                    [[ "$host_alias" == *[\*\?\!]* ]] && continue
                    printf '%s\n' "$host_alias"
                done
                ;;
            include)
                local include_pattern
                for include_pattern in $rest; do
                    include_pattern="${include_pattern/#\~/$HOME}"
                    while IFS= read -r include; do
                        [ -n "$include" ] || continue
                        _list_ssh_hosts_from_file "$include"
                    done < <(compgen -G "$include_pattern")
                done
                ;;
        esac
    done < "$config_file"
}

list_ssh_hosts() {
    local config_file="$HOME/.ssh/config"
    _list_ssh_hosts_from_file "$config_file" | sort -u
}

# Configuration priority: Environment variable > Config file > Default
# Home networks (can be overridden by environment variable, comma-separated)
HOME_NETWORK="${HOME_NETWORK:-${CONFIG_HOME_NETWORK:-$DEFAULT_HOME_NETWORK}}"
# Home gateway MAC addresses (can be overridden by environment variable, comma-separated)
HOME_GATEWAY_MAC="${HOME_GATEWAY_MAC:-${CONFIG_HOME_GATEWAY_MAC:-$DEFAULT_HOME_GATEWAY_MAC}}"
# Treat Tailscale hosts as home network (can be overridden by environment variable)
TAILSCALE_AS_HOME="${TAILSCALE_AS_HOME:-${CONFIG_TAILSCALE_AS_HOME:-$DEFAULT_TAILSCALE_AS_HOME}}"
# Where to look for the Tailscale CLI when it is not on PATH
TAILSCALE_CLI_BUNDLE_PATH="${TAILSCALE_CLI_BUNDLE_PATH:-${CONFIG_TAILSCALE_CLI_BUNDLE_PATH:-$DEFAULT_TAILSCALE_CLI_BUNDLE_PATH}}"
# Security key path (can be overridden by environment variable)
SECURITY_KEY_PATH="${SECURITY_KEY_PATH:-${CONFIG_SECURITY_KEY_PATH:-$DEFAULT_SECURITY_KEY_PATH}}"
# Expand ~ in SECURITY_KEY_PATH
SECURITY_KEY_PATH="${SECURITY_KEY_PATH/#\~/$HOME}"
# Log level
LOG_LEVEL="${LOG_LEVEL:-${CONFIG_LOG_LEVEL:-$DEFAULT_LOG_LEVEL}}"
# OIDC settings
OIDC_ENABLED="${OIDC_ENABLED:-${CONFIG_OIDC_ENABLED:-$DEFAULT_OIDC_ENABLED}}"
OIDC_ISSUER="${OIDC_ISSUER:-${CONFIG_OIDC_ISSUER:-$DEFAULT_OIDC_ISSUER}}"
OIDC_CLIENT_ID="${OIDC_CLIENT_ID:-${CONFIG_OIDC_CLIENT_ID:-$DEFAULT_OIDC_CLIENT_ID}}"
OIDC_CLIENT_SECRET="${OIDC_CLIENT_SECRET:-${CONFIG_OIDC_CLIENT_SECRET:-$DEFAULT_OIDC_CLIENT_SECRET}}"
OIDC_SCOPES="${OIDC_SCOPES:-${CONFIG_OIDC_SCOPES:-$DEFAULT_OIDC_SCOPES}}"
OIDC_CA_URL="${OIDC_CA_URL:-${CONFIG_OIDC_CA_URL:-$DEFAULT_OIDC_CA_URL}}"
OIDC_CA_PROVISIONER="${OIDC_CA_PROVISIONER:-${CONFIG_OIDC_CA_PROVISIONER:-$DEFAULT_OIDC_CA_PROVISIONER}}"
OIDC_CA_MODE="${OIDC_CA_MODE:-${CONFIG_OIDC_CA_MODE:-$DEFAULT_OIDC_CA_MODE}}"
OIDC_CERT_LIFETIME="${OIDC_CERT_LIFETIME:-${CONFIG_OIDC_CERT_LIFETIME:-$DEFAULT_OIDC_CERT_LIFETIME}}"
OIDC_CERT_DIR="${OIDC_CERT_DIR:-${CONFIG_OIDC_CERT_DIR:-$DEFAULT_OIDC_CERT_DIR}}"
# Expand ~ in OIDC_CERT_DIR
OIDC_CERT_DIR="${OIDC_CERT_DIR/#\~/$HOME}"
OIDC_AUTH_MODE="${OIDC_AUTH_MODE:-${CONFIG_OIDC_AUTH_MODE:-$DEFAULT_OIDC_AUTH_MODE}}"

# Color output support (respects NO_COLOR environment variable)
if [ -t 1 ] && [ -z "${NO_COLOR}" ]; then
    COLOR_RESET='\033[0m'
    COLOR_RED='\033[0;31m'
    COLOR_GREEN='\033[0;32m'
    COLOR_YELLOW='\033[0;33m'
    COLOR_BLUE='\033[0;34m'
    COLOR_CYAN='\033[0;36m'
else
    COLOR_RESET=''
    COLOR_RED=''
    COLOR_GREEN=''
    COLOR_YELLOW=''
    COLOR_BLUE=''
    COLOR_CYAN=''
fi

# Log level constants
LOG_LEVEL_DEBUG=0
LOG_LEVEL_INFO=1
LOG_LEVEL_WARN=2
LOG_LEVEL_ERROR=3

# Convert log level string to number
get_log_level_number() {
    local level_lower=$(echo "$LOG_LEVEL" | tr '[:upper:]' '[:lower:]')
    case "$level_lower" in
        debug) echo $LOG_LEVEL_DEBUG ;;
        info) echo $LOG_LEVEL_INFO ;;
        warn) echo $LOG_LEVEL_WARN ;;
        error) echo $LOG_LEVEL_ERROR ;;
        *) echo $LOG_LEVEL_INFO ;;
    esac
}

CURRENT_LOG_LEVEL=$(get_log_level_number)
# Ensure CURRENT_LOG_LEVEL is set (default to INFO if empty)
CURRENT_LOG_LEVEL=${CURRENT_LOG_LEVEL:-$LOG_LEVEL_INFO}

# Print functions for colored output.
#
# The colour is %b so its escape sequences expand; the message is %s so its own
# do not. `echo -e` would expand both, which turns a backslash sequence carried
# in a message — a remote-command argument, a hostname from a config — into real
# control bytes, letting it forge log lines or drive the terminal.
print_error() {
    printf '%b%s%b\n' "$COLOR_RED" "$*" "$COLOR_RESET" >&2
}

print_success() {
    printf '%b%s%b\n' "$COLOR_GREEN" "$*" "$COLOR_RESET"
}

print_warning() {
    printf '%b%s%b\n' "$COLOR_YELLOW" "$*" "$COLOR_RESET"
}

print_info() {
    printf '%b%s%b\n' "$COLOR_CYAN" "$*" "$COLOR_RESET"
}

print_debug() {
    printf '%b%s%b\n' "$COLOR_BLUE" "$*" "$COLOR_RESET"
}

# Render an argv for display. Two reasons this cannot be "${array[*]}":
# quoting is lost, so a single argument containing spaces prints as several and
# the shown command stops matching the one that runs; and a control byte in an
# argument would reach the terminal raw. %q turns both into inert,
# copy-pasteable text — the print_* helpers then emit it without re-expanding it.
render_argv() {
    printf '%q ' "$@" | sed 's/ $//'
}

# Logging functions with log level support
log_error() {
    if [ "$CURRENT_LOG_LEVEL" -le "$LOG_LEVEL_ERROR" ]; then
        print_error "[ERROR] $*"
    fi
}

log_warn() {
    if [ "$CURRENT_LOG_LEVEL" -le "$LOG_LEVEL_WARN" ]; then
        print_warning "[WARN] $*"
    fi
}

log_info() {
    if [ "$CURRENT_LOG_LEVEL" -le "$LOG_LEVEL_INFO" ]; then
        print_info "[INFO] $*"
    fi
}

log_debug() {
    if [ "$CURRENT_LOG_LEVEL" -le "$LOG_LEVEL_DEBUG" ]; then
        print_debug "[DEBUG] $*"
    fi
}

# Show usage information
usage() {
    echo "Usage: $0 [OPTIONS] [SSH_OPTIONS] <hostname> [COMMAND ...]"
    echo ""
    echo "Examples:"
    echo "  $0 hostname"
    echo "  $0 production-server"
    echo "  $0 -v hostname                    # Pass -v to ssh for verbose output"
    echo "  $0 -p 2222 hostname               # Use custom SSH port"
    echo "  $0 hostname uptime                # Run a command on the remote host"
    echo "  $0 hostname df -h                 # Its arguments go to the remote too"
    echo "  $0 -- -v hostname                 # Use -- to separate options"
    echo "  HOME_GATEWAY_MAC=aa:bb:cc:dd:ee:ff $0 hostname  # Use MAC-based detection"
    echo "  HOME_NETWORK=192.168.1.0/24,10.0.0.0/24 $0 hostname"
    echo "  SECURITY_KEY_PATH=~/.ssh/id_ecdsa_sk $0 --security-key hostname"
    echo ""
    echo "Required SSH config pattern (~/.ssh/config):"
    echo "  Host <hostname>                # Single host entry"
    echo "                                 # Regular key specified in IdentityFile"
    echo "                                 # Security key used with -i when away"
    echo ""
    echo "Smart-SSH Options:"
    echo "  --security-key, -s   Force security key authentication"
    echo "  --oidc               Force OIDC Device Flow authentication (no fallback)"
    echo "  --dry-run, -n        Show what would be executed without connecting"
    echo "  --init-config        Create default configuration file"
    echo "  --debug, -d          Show debug information"
    echo "  --help, -h           Show this help message"
    echo "  --version            Show version information"
    echo "  --                   End of smart-ssh options (SSH options may follow,"
    echo "                       then the hostname, then the remote command)"
    echo ""
    echo "SSH Options:"
    echo "  Any SSH options (like -v, -p, -L, etc.) are passed through to ssh."
    echo "  Place them BEFORE the hostname. smart-ssh treats the hostname as the"
    echo "  boundary: everything after it is the command to run remotely, and ssh"
    echo "  is passed -- so it cannot read those words as options of its own."
    echo ""
    echo "Configuration:"
    echo "  Config file: $CONFIG_FILE"
    echo "  Priority: Environment variable > Config file > Default"
    echo ""
    echo "Author: https://github.com/ngc-shj/smart-ssh"
}

# Initialize configuration file
init_config() {
    if [ -f "$CONFIG_FILE" ]; then
        print_warning "Configuration file already exists: $CONFIG_FILE"
        read -rp "Overwrite? (y/N): " confirm
        if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
            echo "Cancelled."
            return 1
        fi
    fi

    # Create config directory if it doesn't exist
    mkdir -p "$CONFIG_DIR"

    # Create default configuration file
    cat > "$CONFIG_FILE" <<'EOF'
# smart-ssh configuration file
# This file follows the format: KEY=value
# Lines starting with # are comments

# Treat Tailscale hosts as home network (true/false)
# When enabled, connections to Tailscale nodes are treated as home network
# and use regular public key authentication.
# Detection asks the local Tailscale daemon and nothing else; when it cannot
# be reached the connection is treated as external (security key required).
# Requires jq and the tailscale CLI.
# Default: true
TAILSCALE_AS_HOME=true

# Where to find the Tailscale CLI when it is not on PATH (the macOS App Store
# build keeps it inside the app bundle). Must be owned by root to be trusted.
# Default: /Applications/Tailscale.app/Contents/MacOS/Tailscale
#TAILSCALE_CLI_BUNDLE_PATH=

# Home gateway MAC addresses (comma-separated, preferred detection method)
# Use 'smart-ssh --debug' to find your gateway MAC address
# Example: HOME_GATEWAY_MAC=aa:bb:cc:dd:ee:ff,11:22:33:44:55:66
HOME_GATEWAY_MAC=

# Home networks (comma-separated CIDR ranges, fallback detection method)
# Example: HOME_NETWORK=192.168.1.0/24,10.0.0.0/24,172.16.0.0/12
HOME_NETWORK=192.168.1.0/24

# Security key path
# Default: ~/.ssh/id_ed25519_sk
SECURITY_KEY_PATH=~/.ssh/id_ed25519_sk

# Log level (debug, info, warn, error)
# Default: info
LOG_LEVEL=info

# OIDC Device Flow authentication
# Enable OIDC Device Flow for certificate-based SSH authentication (true/false)
# Default: false
#OIDC_ENABLED=false

# OIDC issuer URL (must use https://)
# Example: OIDC_ISSUER=https://accounts.example.com
#OIDC_ISSUER=

# OIDC client ID registered with the issuer
# Example: OIDC_CLIENT_ID=smart-ssh-cli
#OIDC_CLIENT_ID=

# OIDC client secret (required by some providers like Google)
#OIDC_CLIENT_SECRET=

# OIDC scopes (space-separated)
# Default: openid email
#OIDC_SCOPES=openid email

# CA server URL for SSH certificate signing (must use https://)
# Example: OIDC_CA_URL=https://ca.example.com
#OIDC_CA_URL=

# CA provisioner name for OIDC
# Default: oidc
#OIDC_CA_PROVISIONER=oidc

# CA mode: "api" (curl direct) - "step" is future work
# Default: api
#OIDC_CA_MODE=api

# Certificate lifetime in seconds
# Default: 3600
#OIDC_CERT_LIFETIME=3600

# Directory to cache OIDC certificates and keys
# Default: ~/.ssh/oidc-certs
#OIDC_CERT_DIR=~/.ssh/oidc-certs

# OIDC authentication mode: auto|prefer|only|disabled
#   auto     - use OIDC when sk key file is absent; no fallback on failure
#   prefer   - prefer OIDC; fall back to sk key on network/CA error (exit 2) only
#   only     - OIDC only; no fallback
#   disabled - OIDC disabled
# Default: auto
#OIDC_AUTH_MODE=auto
EOF

    print_success "Configuration file created: $CONFIG_FILE"
    echo ""
    echo "Edit the file to customize your settings:"
    echo "  ${EDITOR:-vi} $CONFIG_FILE"
    return 0
}

# Validate IP address format
validate_ip() {
    local ip="$1"
    local valid_ip_regex='^([0-9]{1,3}\.){3}[0-9]{1,3}$'

    if ! [[ "$ip" =~ $valid_ip_regex ]]; then
        return 1
    fi

    # Check each octet is 0-255
    local -a octets
    IFS='.' read -ra octets <<< "$ip"
    for octet in "${octets[@]}"; do
        if [ "$octet" -lt 0 ] || [ "$octet" -gt 255 ]; then
            return 1
        fi
    done

    return 0
}

# Validate CIDR format
validate_cidr() {
    local cidr="$1"

    if [[ ! "$cidr" =~ ^[^/]+/[0-9]+$ ]]; then
        print_error "Error: Invalid CIDR format: $cidr"
        echo "Expected format: IP/MASK (e.g., 192.168.1.0/24)" >&2
        return 1
    fi

    local network=$(echo "$cidr" | cut -d'/' -f1)
    local mask_bits=$(echo "$cidr" | cut -d'/' -f2)

    # Validate IP address
    if ! validate_ip "$network"; then
        print_error "Error: Invalid IP address in CIDR: $network"
        return 1
    fi

    # Validate mask bits (0-32)
    if [ "$mask_bits" -lt 0 ] || [ "$mask_bits" -gt 32 ]; then
        print_error "Error: Invalid network mask bits: $mask_bits (must be 0-32)"
        return 1
    fi

    return 0
}

# Get gateway IP address
get_gateway_ip() {
    local gateway_ip=""

    if [[ "$OSTYPE" == "darwin"* ]]; then
        # macOS
        gateway_ip=$(route -n get default 2>/dev/null | grep 'gateway:' | awk '{print $2}')
    elif command -v ip >/dev/null 2>&1; then
        # Linux with ip command
        gateway_ip=$(ip route show default 2>/dev/null | awk '/default/ {print $3}')
    elif command -v route >/dev/null 2>&1; then
        # Linux with route command
        gateway_ip=$(route -n 2>/dev/null | awk '/^0.0.0.0/ {print $2}')
    fi

    if [ -n "$gateway_ip" ]; then
        echo "$gateway_ip"
        return 0
    fi
    return 1
}

# Get gateway MAC address via ARP
get_gateway_mac() {
    local gateway_ip
    gateway_ip=$(get_gateway_ip)

    if [ -z "$gateway_ip" ]; then
        log_debug "Cannot determine gateway IP"
        return 1
    fi

    local mac=""

    if [[ "$OSTYPE" == "darwin"* ]]; then
        # macOS: arp -n <ip> returns "? (192.168.1.1) at aa:bb:cc:dd:ee:ff on en0 ..."
        mac=$(arp -n "$gateway_ip" 2>/dev/null | awk '{print $4}')
    elif command -v ip >/dev/null 2>&1; then
        # Linux with ip command
        mac=$(ip neigh show "$gateway_ip" 2>/dev/null | awk '{print $5}')
    elif command -v arp >/dev/null 2>&1; then
        # Linux with arp command
        mac=$(arp -n "$gateway_ip" 2>/dev/null | awk 'NR>1 {print $3}')
    fi

    # Normalize MAC address to lowercase
    if [ -n "$mac" ] && [ "$mac" != "(incomplete)" ]; then
        echo "$mac" | tr '[:upper:]' '[:lower:]'
        return 0
    fi

    return 1
}

# Check if current gateway MAC matches any home gateway MAC
is_home_gateway_mac() {
    local current_mac="$1"

    if [ -z "$current_mac" ] || [ -z "$HOME_GATEWAY_MAC" ]; then
        return 1
    fi

    # Normalize current MAC to lowercase
    current_mac=$(echo "$current_mac" | tr '[:upper:]' '[:lower:]')

    # Split HOME_GATEWAY_MAC by comma and check each
    IFS=',' read -ra macs <<< "$HOME_GATEWAY_MAC"
    for mac in "${macs[@]}"; do
        # Trim whitespace and normalize to lowercase
        mac=$(echo "$mac" | xargs | tr '[:upper:]' '[:lower:]')
        if [ "$current_mac" = "$mac" ]; then
            return 0
        fi
    done
    return 1
}

# Get current local IP address
get_current_ip() {
    local ip
    
    if [[ "$OSTYPE" == "darwin"* ]]; then
        # macOS
        local default_interface=$(route get default 2>/dev/null | grep interface: | awk '{print $2}')
        if [ -n "$default_interface" ]; then
            ip=$(ifconfig "$default_interface" 2>/dev/null | grep 'inet ' | grep -v '127.0.0.1' | head -1 | awk '{print $2}')
        fi
    elif grep -qi "microsoft.*wsl\|wsl.*microsoft" /proc/version 2>/dev/null || command -v powershell.exe >/dev/null 2>&1; then
        # WSL2 - get Windows host WiFi IP (not WSL2 internal IP)
        ip=$(powershell.exe -Command "
            \$wifiAdapter = Get-NetAdapter | Where-Object {\$_.InterfaceDescription -like '*Wi-Fi*' -and \$_.Status -eq 'Up'}
            if (\$wifiAdapter) {
                \$ipConfig = Get-NetIPAddress -InterfaceIndex \$wifiAdapter.InterfaceIndex -AddressFamily IPv4 | Where-Object {\$_.AddressState -eq 'Preferred' -and \$_.IPAddress -notlike '169.254.*'}
                if (\$ipConfig) {
                    \$ipConfig.IPAddress
                } else {
                    'NOT_CONNECTED'
                }
            } else {
                'NOT_CONNECTED'
            }
        " 2>/dev/null | tr -d '\r\n')
    elif command -v ip >/dev/null 2>&1; then
        # Linux with ip command
        ip=$(ip route get 8.8.8.8 2>/dev/null | grep -oP 'src \K\S+')
    elif command -v ifconfig >/dev/null 2>&1; then
        # Linux/Unix with ifconfig
        ip=$(ifconfig 2>/dev/null | grep 'inet ' | grep -v '127.0.0.1' | head -1 | awk '{print $2}' | sed 's/addr://')
    else
        echo "Error: Cannot determine local IP address" >&2
        return 1
    fi
    
    if [ -z "$ip" ] || [ "$ip" = "127.0.0.1" ]; then
        echo "NOT_CONNECTED"
    else
        echo "$ip"
    fi
}

# Convert IP address to 32-bit integer
ip_to_int() {
    local ip="$1"
    local a b c d
    IFS='.' read -r a b c d <<< "$ip"
    echo $((a * 256 * 256 * 256 + b * 256 * 256 + c * 256 + d))
}

# Check if IP is in CIDR range using integer comparison
ip_in_cidr() {
    local ip="$1"
    local cidr="$2"

    # Validate CIDR format
    if ! validate_cidr "$cidr"; then
        return 1
    fi

    # Validate IP address
    if ! validate_ip "$ip"; then
        print_error "Error: Invalid IP address: $ip"
        return 1
    fi

    local network=$(echo "$cidr" | cut -d'/' -f1)
    local mask_bits=$(echo "$cidr" | cut -d'/' -f2)

    # Convert IP and network to integers
    local ip_int=$(ip_to_int "$ip")
    local network_int=$(ip_to_int "$network")

    # Calculate network mask
    local mask=$((0xFFFFFFFF << (32 - mask_bits)))

    # Apply mask to both IP and network
    local ip_network=$((ip_int & mask))
    local cidr_network=$((network_int & mask))

    # Check if they match
    [ "$ip_network" -eq "$cidr_network" ]
}

# Check if current IP is in home network ranges
is_home_network() {
    local current_ip="$1"
    
    # Check if IP is valid
    if [ "$current_ip" = "NOT_CONNECTED" ] || [ -z "$current_ip" ]; then
        return 1
    fi
    
    # Split HOME_NETWORK by comma and check each network
    IFS=',' read -ra networks <<< "$HOME_NETWORK"
    for network in "${networks[@]}"; do
        # Trim whitespace
        network=$(echo "$network" | xargs)
        if ip_in_cidr "$current_ip" "$network"; then
            return 0
        fi
    done
    return 1
}

# Resolve a hostname through the OS resolver: getent (NSS) on Linux,
# dscacheutil on macOS. Unlike host/dig these answer for mDNS (.local) names
# and /etc/hosts entries, at the cost of trusting unauthenticated mDNS replies.
resolve_hostname_via_os() {
    local hostname="$1"
    local candidates=""

    if command -v getent >/dev/null 2>&1; then
        candidates=$(getent hosts "$hostname" 2>/dev/null | awk '{print $1}')
    fi

    if [ -z "$candidates" ] && command -v dscacheutil >/dev/null 2>&1; then
        candidates=$(dscacheutil -q host -a name "$hostname" 2>/dev/null \
            | awk '/^ip_address: |^ipv6_address: / {print $2}')
    fi

    [ -n "$candidates" ] || return 1

    # A multi-homed host lists 127.0.0.1 first and mDNS advertises fe80:: link-
    # local addresses; neither says the host is reachable. Keep them only when
    # the name has nothing else to offer. 169.254.0.0/16 is excluded for the
    # same reason it is on the local-IP path (see get_current_ip).
    local routable
    routable=$(printf '%s\n' "$candidates" | grep -Ev '^(127\.|169\.254\.|::1$|fe80:)')
    [ -n "$routable" ] && candidates="$routable"

    # IPv4 first — callers match the result against IPv4 CIDR ranges
    local address
    address=$(printf '%s\n' "$candidates" | grep -E '^[0-9]+\.' | head -1)
    [ -n "$address" ] || address=$(printf '%s\n' "$candidates" | head -1)

    echo "$address"
}

# Resolve hostname to IP address using available DNS tools
# Try each tool in sequence until one succeeds, since some tools
# (e.g., dig) bypass the system resolver and may miss Tailscale MagicDNS
#
# The second argument picks how far the resolver may reach:
#   dns    (default) unicast DNS only, and never the OS resolver — not even
#          when no DNS tool is installed and the answer would be nothing.
#   system also asks the OS resolver, which sees mDNS/.local and /etc/hosts.
#          An mDNS reply needs nothing but presence on the link, so this mode
#          is for reachability checks only.
#
# No caller passes `dns` today — check_ssh_config is the only caller and it
# opts in to `system`. The tier stays because `system` must be asked for
# explicitly: a future caller that lands here by copy-paste gets the safe mode
# by omission, and a caller that selects credentials must never get the other.
resolve_hostname() {
    local hostname="$1"
    local source="${2:-dns}"
    local resolved_ip=""

    # host uses system resolver (works with Tailscale MagicDNS)
    if [ -z "$resolved_ip" ] && command -v host >/dev/null 2>&1; then
        resolved_ip=$(host -t A "$hostname" 2>/dev/null | awk '/has address/ {print $4}' | head -1)
    fi

    # dig may bypass system resolver, but try as fallback
    if [ -z "$resolved_ip" ] && command -v dig >/dev/null 2>&1; then
        resolved_ip=$(dig +short "$hostname" A 2>/dev/null | grep -E '^[0-9]+\.' | head -1)
    fi

    if [ -z "$resolved_ip" ] && [ "$source" = "system" ]; then
        resolved_ip=$(resolve_hostname_via_os "$hostname")
    fi

    if [ -n "$resolved_ip" ]; then
        echo "$resolved_ip"
        return 0
    fi
    return 1
}

# Locate the Tailscale CLI. It is not always on PATH: the macOS App Store
# build ships it inside the bundle and installs no symlink, and that is exactly
# the population that used to depend on the removed heuristic.
# On success sets TAILSCALE_CLI. It reports through a variable rather than
# stdout so that it can log: a function whose stdout is its return value has
# its diagnostics swallowed by the caller's command substitution.
TAILSCALE_CLI=""
find_tailscale_cli() {
    TAILSCALE_CLI=""
    local cli
    if cli=$(command -v tailscale 2>/dev/null); then
        TAILSCALE_CLI="$cli"
        return 0
    fi

    # -f as well as -x: a directory is executable too, and accepting one turns
    # a mistyped path into a misleading "daemon is not running"
    cli="$TAILSCALE_CLI_BUNDLE_PATH"
    if [ -n "$cli" ] && [ -f "$cli" ] && [ -x "$cli" ]; then
        # This path is consulted only when Tailscale is absent from PATH, so
        # nothing legitimate should occupy it — and on macOS /Applications is
        # group-writable, meaning any process running as the user could put a
        # fake CLI there and vouch for any host. Run it only if root owns it.
        local owner
        owner=$(stat -f '%u' "$cli" 2>/dev/null || stat -c '%u' "$cli" 2>/dev/null)
        if [ "$owner" = "0" ]; then
            TAILSCALE_CLI="$cli"
            return 0
        fi
        log_warn "Ignoring $cli: not owned by root, so it cannot be trusted to answer for the tailnet"
    fi

    return 1
}

# Find the tailnet address of an SSH target, using only what the daemon knows.
#
# 'tailscale whois' takes an address, never a name, so a name has to be mapped
# to one first. That mapping is deliberately not 'tailscale ip <name>': for a
# name the daemon does not recognise, that command falls back to a system DNS
# lookup and reports whichever peer owns the address that comes back. On an
# untrusted network the resolver belongs to the attacker, so it would let them
# choose the address this decision is made about. Matching against the daemon's
# own peer list keeps DNS out of this lookup.
#
# Accepts a tailnet address or a full MagicDNS name, with or without the
# trailing dot and in any case — DNS names are case-insensitive. A bare node
# label is deliberately NOT accepted: `HostName nas` for a LAN machine would
# then match an unrelated tailnet peer that happens to be called nas, and a
# bare label is also the form with the weakest binding to the tailnet.
tailscale_peer_ip() {
    local cli="$1"
    local target="$2"

    "$cli" status --json 2>/dev/null | jq -r --arg target "$target" '
        def norm: (. // "") | rtrimstr(".") | ascii_downcase;
        ($target | norm) as $t
        | [.Self] + (.Peer // {} | to_entries | map(.value))
        | map(select(
            (((.TailscaleIPs // []) | map(norm) | index($t)) != null)
            or ((.DNSName | norm) == $t)
          ))
        | .[0].TailscaleIPs[0] // empty
    ' 2>/dev/null
}

# Check if the SSH target host is a Tailscale node.
#
# Only the local daemon answers this. It is the one party that knows the
# tailnet and the one the network we may be defending against cannot reach.
# There is deliberately no fallback: every property observable without it (the
# destination being in 100.64.0.0/10, a *.ts.net name, a DNS answer, this
# machine holding a CGNAT address) is supplied by, or forgeable by, whoever
# runs the network. 100.64.0.0/10 in particular is shared CGNAT space that a
# hostile DHCP server can hand out, so holding such an address is not evidence
# of a tunnel. Guessing wrong here means using the on-disk key on a network
# where the security key was required, so with no daemon the answer is no.
#
# On success sets TAILSCALE_PEER_IP to the address the daemon vouched for. The
# caller must connect to THAT address: this function proves a peer of that name
# exists on the tailnet, not that the name still resolves to it. ssh would
# resolve the name again through the system resolver, which belongs to the
# attacker whenever Tailscale is not managing DNS (--accept-dns=false, MagicDNS
# off, or a platform where it cannot own resolv.conf).
#
# Takes the SSH options the connection will actually use, and evaluates them:
# `smart-ssh myhost -o HostName=elsewhere` (or -F, or a jump host) makes ssh
# talk to a different machine than the bare alias names, and verifying the
# alias would vouch for a host nobody is connecting to. Also sets
# TAILSCALE_HOST_KEY_ALIAS to the name known_hosts should be keyed on, or
# empty when the config already sets HostKeyAlias and ours must not override.
TAILSCALE_PEER_IP=""
TAILSCALE_HOST_KEY_ALIAS=""
TAILSCALE_RESOLVED_HOST=""
is_tailscale_host() {
    local hostname="$1"
    shift
    local ssh_options=("$@")
    TAILSCALE_PEER_IP=""
    TAILSCALE_HOST_KEY_ALIAS=""
    TAILSCALE_RESOLVED_HOST=""

    # Resolve the config as ssh will see it, options included
    local ssh_config
    ssh_config=$(ssh -G "${ssh_options[@]}" -- "$hostname" 2>/dev/null)

    local resolved_host
    resolved_host=$(echo "$ssh_config" | awk '/^hostname / {print $2}')

    if [ -z "$resolved_host" ]; then
        return 1
    fi

    # Only supply a HostKeyAlias if nothing else did; overriding a configured
    # one would look up the wrong known_hosts entry
    if ! echo "$ssh_config" | grep -q '^hostkeyalias '; then
        TAILSCALE_HOST_KEY_ALIAS="$resolved_host"
    fi

    log_debug "Tailscale check: resolved HostName=$resolved_host"

    if ! command -v jq >/dev/null 2>&1; then
        log_warn "jq not found; cannot verify $resolved_host is a Tailscale node, treating as external"
        return 1
    fi

    if ! find_tailscale_cli; then
        log_warn "Tailscale CLI not found; cannot verify $resolved_host is a Tailscale node, treating as external"
        return 1
    fi
    local tailscale_cli="$TAILSCALE_CLI"

    if ! "$tailscale_cli" status >/dev/null 2>&1; then
        log_warn "Tailscale daemon is not running; cannot verify $resolved_host is a Tailscale node, treating as external"
        return 1
    fi

    local peer_ip
    peer_ip=$(tailscale_peer_ip "$tailscale_cli" "$resolved_host")
    if [ -z "$peer_ip" ]; then
        log_warn "$resolved_host is not a node on this tailnet (matched against tailnet addresses and MagicDNS names); treating as external. If it is reached over Tailscale under a different name, set HostName to its MagicDNS name or tailnet address, or use HOME_GATEWAY_MAC/HOME_NETWORK."
        return 1
    fi

    # The verdict comes from stdout, not $?: an answer that identifies nobody
    # has to be refused the same way an error is, and the CLI's exit status for
    # a rejected argument has varied across releases
    local whois_output
    whois_output=$("$tailscale_cli" whois --json "$peer_ip" 2>/dev/null)
    if [ -z "$whois_output" ]; then
        log_debug "Tailscale whois: no answer for $resolved_host ($peer_ip)"
        return 1
    fi

    # Validate JSON and check Node.ID exists and is non-zero
    local node_id
    if ! node_id=$(echo "$whois_output" | jq -r '.Node.ID // 0' 2>/dev/null); then
        log_debug "Tailscale whois: jq parse failed for $resolved_host ($peer_ip)"
        return 1
    fi

    if [ -n "$node_id" ] && [ "$node_id" != "0" ] && [ "$node_id" != "null" ]; then
        log_debug "Tailscale detected via whois: Node.ID=$node_id ($resolved_host -> $peer_ip)"
        TAILSCALE_PEER_IP="$peer_ip"
        TAILSCALE_RESOLVED_HOST="$resolved_host"
        return 0
    fi

    log_debug "Tailscale whois: $resolved_host ($peer_ip) is not a Tailscale node"
    return 1
}

# Check required dependencies for OIDC Device Flow
check_oidc_dependencies() {
    local missing=()

    if ! command -v jq >/dev/null 2>&1; then
        missing+=("jq")
    fi
    if ! command -v curl >/dev/null 2>&1; then
        missing+=("curl")
    fi

    if [ ${#missing[@]} -gt 0 ]; then
        log_error "OIDC requires missing dependencies: ${missing[*]}"
        log_error "Install them and try again."
        return 1
    fi
    return 0
}

# Validate SSH hostname for safe use in temp config files
# Prevents injection via newlines, spaces, or wildcards
validate_ssh_hostname() {
    local name="$1"
    if [[ ! "$name" =~ ^[a-zA-Z0-9._:%-]+$ ]]; then
        if [[ "$name" == *,* ]]; then
            log_error "Multi-hop ProxyJump ('$name') is not supported in security key / OIDC mode"
        else
            log_error "Invalid SSH hostname: '$name' (contains unsafe characters)"
        fi
        return 1
    fi
    return 0
}

# Validate OIDC_CERT_LIFETIME (positive integer, max 86400 seconds = 24 hours)
validate_oidc_cert_lifetime() {
    if [[ ! "$OIDC_CERT_LIFETIME" =~ ^[0-9]+$ ]]; then
        log_error "OIDC_CERT_LIFETIME must be a positive integer <= 86400 (got: '${OIDC_CERT_LIFETIME}')"
        return 1
    fi
    if [ "$OIDC_CERT_LIFETIME" -le 0 ] || [ "$OIDC_CERT_LIFETIME" -gt 86400 ]; then
        log_error "OIDC_CERT_LIFETIME must be a positive integer <= 86400 (got: '${OIDC_CERT_LIFETIME}')"
        return 1
    fi
    return 0
}

# Validate that OIDC_ISSUER and OIDC_CA_URL use https:// scheme
validate_oidc_urls() {
    if [ -z "$OIDC_ISSUER" ] || [[ "$OIDC_ISSUER" != https://* ]]; then
        log_error "OIDC_ISSUER must be set and start with https:// (got: '${OIDC_ISSUER}')"
        return 1
    fi
    if [ -z "$OIDC_CA_URL" ] || [[ "$OIDC_CA_URL" != https://* ]]; then
        log_error "OIDC_CA_URL must be set and start with https:// (got: '${OIDC_CA_URL}')"
        return 1
    fi
    return 0
}

# Fetch OIDC discovery document and extract device/token endpoints
# Sets globals: _OIDC_DEVICE_ENDPOINT, _OIDC_TOKEN_ENDPOINT
oidc_discover() {
    local issuer="$1"
    local discovery_url="${issuer%/}/.well-known/openid-configuration"

    log_debug "OIDC discovery: $discovery_url"

    local response
    response=$(curl --fail --silent --show-error --max-time 30 --connect-timeout 10 \
        "$discovery_url" 2>&1)
    if [ $? -ne 0 ]; then
        log_error "OIDC discovery request failed: $response"
        return 2
    fi

    # Validate JSON and extract required fields in a single jq call
    local endpoints
    endpoints=$(echo "$response" | jq -r '[.device_authorization_endpoint // "", .token_endpoint // ""] | @tsv' 2>/dev/null) || {
        log_error "OIDC discovery returned malformed JSON"
        return 2
    }

    local device_endpoint token_endpoint
    device_endpoint=$(echo "$endpoints" | cut -f1)
    token_endpoint=$(echo "$endpoints" | cut -f2)

    if [ -z "$device_endpoint" ]; then
        log_error "OIDC discovery missing device_authorization_endpoint"
        return 2
    fi
    if [ -z "$token_endpoint" ]; then
        log_error "OIDC discovery missing token_endpoint"
        return 2
    fi

    # Validate that endpoints use https:// scheme
    # Note: Same-origin check is not enforced because major providers (Google, Microsoft)
    # use different subdomains for their endpoints (e.g., oauth2.googleapis.com)
    if [[ "$device_endpoint" != https://* ]]; then
        log_error "device_authorization_endpoint must use https://: $device_endpoint"
        return 2
    fi
    if [[ "$token_endpoint" != https://* ]]; then
        log_error "token_endpoint must use https://: $token_endpoint"
        return 2
    fi

    _OIDC_DEVICE_ENDPOINT="$device_endpoint"
    _OIDC_TOKEN_ENDPOINT="$token_endpoint"
    log_debug "device_authorization_endpoint: $_OIDC_DEVICE_ENDPOINT"
    log_debug "token_endpoint: $_OIDC_TOKEN_ENDPOINT"
    return 0
}

# Send Device Authorization Request and display user_code + verification_uri
# Sets globals: _OIDC_DEVICE_CODE, _OIDC_USER_CODE, _OIDC_VERIFICATION_URI,
#               _OIDC_EXPIRES_IN, _OIDC_POLL_INTERVAL
oidc_device_authorize() {
    # NOTE: client_secret is intentionally not sent in the Device Authorization Request.
    # RFC 8628 §3.1 makes it optional, and most providers (Google, Microsoft) don't require it here.
    # client_secret is sent in the token poll request (oidc_poll_token) where it's needed.
    local response
    response=$(curl --fail --silent --show-error --max-time 30 --connect-timeout 10 \
        -X POST "$_OIDC_DEVICE_ENDPOINT" \
        --data-urlencode "client_id=${OIDC_CLIENT_ID}" \
        --data-urlencode "scope=${OIDC_SCOPES}" 2>&1)
    if [ $? -ne 0 ]; then
        log_error "Device authorization request failed: $response"
        return 2
    fi

    # Validate JSON and extract all fields in a single jq call
    # Google uses "verification_url" instead of RFC 8628 "verification_uri"
    local fields
    fields=$(echo "$response" | jq -r '[
        .device_code // "",
        .user_code // "",
        .verification_uri // .verification_url // "",
        (.expires_in // 300 | tostring),
        (.interval // 5 | tostring)
    ] | @tsv' 2>/dev/null) || {
        log_error "Device authorization returned malformed JSON"
        return 2
    }

    _OIDC_DEVICE_CODE=$(echo "$fields" | cut -f1)
    _OIDC_USER_CODE=$(echo "$fields" | cut -f2)
    _OIDC_VERIFICATION_URI=$(echo "$fields" | cut -f3)
    _OIDC_EXPIRES_IN=$(echo "$fields" | cut -f4)
    _OIDC_POLL_INTERVAL=$(echo "$fields" | cut -f5)

    if [ -z "$_OIDC_DEVICE_CODE" ] || [ -z "$_OIDC_USER_CODE" ] || [ -z "$_OIDC_VERIFICATION_URI" ]; then
        log_error "Device authorization response missing required fields"
        return 2
    fi

    # Validate verification_uri uses https:// to prevent phishing
    if [[ "$_OIDC_VERIFICATION_URI" != https://* ]]; then
        log_error "verification_uri must use https:// (got: '$_OIDC_VERIFICATION_URI')"
        return 2
    fi

    echo ""
    print_info "=== OIDC Device Authentication ==="
    print_info "Open this URL in your browser:"
    print_info "  $_OIDC_VERIFICATION_URI"
    print_info ""
    print_info "Enter this code: $_OIDC_USER_CODE"
    print_info "=================================="
    echo ""

    # Attempt to open the verification URL in the default browser
    if command -v xdg-open >/dev/null 2>&1; then
        xdg-open "$_OIDC_VERIFICATION_URI" >/dev/null 2>&1 &
    elif command -v open >/dev/null 2>&1; then
        open "$_OIDC_VERIFICATION_URI" >/dev/null 2>&1 &
    fi

    return 0
}

# Poll token endpoint until access granted, error, or timeout (RFC 8628)
# Sets global: _OIDC_ID_TOKEN
# Returns: 0 on success, 2 on network error, 3 on access_denied/expired_token/timeout
oidc_poll_token() {
    # Allow test overrides; minimum enforced interval is 5 seconds
    local server_interval="${_OIDC_POLL_INTERVAL:-5}"
    local current_interval
    # Enforce client-side minimum of 5 seconds
    if [ "$server_interval" -lt 5 ] 2>/dev/null; then
        current_interval=5
    else
        current_interval="$server_interval"
    fi

    local expires_in="${_OIDC_EXPIRES_IN:-300}"
    local timeout="${_OIDC_POLL_TIMEOUT_OVERRIDE:-$expires_in}"
    local elapsed=0

    # _OIDC_POLL_TIMEOUT_OVERRIDE=0 means immediate timeout
    if [ "$timeout" -eq 0 ] 2>/dev/null; then
        log_error "OIDC polling timed out waiting for authorization"
        return 3
    fi

    log_info "Waiting for authorization (timeout: ${timeout}s)..."

    # Write POST body to temp file once (content is constant across iterations)
    # Avoids cmdline exposure of client_secret
    local poll_data_file
    poll_data_file=$(umask 077 && mktemp) || {
        log_error "Failed to create temp file for token poll"
        return 2
    }
    _cleanup_poll() { rm -f "$poll_data_file"; }
    local _poll_interrupted=false
    trap '_cleanup_poll; _poll_interrupted=true' INT TERM
    # Percent-encode values per RFC 3986 (application/x-www-form-urlencoded)
    {
        printf 'grant_type=%s' "urn%3Aietf%3Aparams%3Aoauth%3Agrant-type%3Adevice_code"
        printf '&device_code=%s' "$(printf '%s' "${_OIDC_DEVICE_CODE}" | jq -sRr @uri)"
        printf '&client_id=%s' "$(printf '%s' "${OIDC_CLIENT_ID}" | jq -sRr @uri)"
        if [ -n "$OIDC_CLIENT_SECRET" ]; then
            printf '&client_secret=%s' "$(printf '%s' "${OIDC_CLIENT_SECRET}" | jq -sRr @uri)"
        fi
    } > "$poll_data_file" || {
        log_error "Failed to write token poll body"
        _cleanup_poll; return 2
    }

    while [ "$elapsed" -lt "$timeout" ]; do
        # Check if interrupted by INT/TERM signal
        if [ "$_poll_interrupted" = true ]; then
            log_error "Token polling interrupted"
            return 2
        fi

        # NOTE: _OIDC_POLL_INTERVAL_OVERRIDE is for testing only; it bypasses
        # slow_down enforcement. Must not be set in production.
        local sleep_time="${_OIDC_POLL_INTERVAL_OVERRIDE:-$current_interval}"

        sleep "$sleep_time"

        # Check again after sleep (signal most likely arrives during sleep)
        if [ "$_poll_interrupted" = true ]; then
            log_error "Token polling interrupted"
            return 2
        fi
        # Ensure elapsed always advances to prevent infinite loop
        local increment=$(( sleep_time > 0 ? sleep_time : 1 ))
        elapsed=$((elapsed + increment))

        # Do NOT use --fail here: RFC 8628 returns HTTP 400 for
        # authorization_pending/slow_down which are expected responses
        local response http_code
        response=$(curl --silent --show-error --max-time 30 --connect-timeout 10 \
            -w '\n%{http_code}' \
            -X POST "$_OIDC_TOKEN_ENDPOINT" \
            -d @"$poll_data_file" 2>&1)
        local curl_exit=$?

        # Extract HTTP status code (last line) and response body
        http_code=$(echo "$response" | tail -1)
        response=$(echo "$response" | sed '$d')

        # Network-level error (curl itself failed)
        if [ $curl_exit -ne 0 ]; then
            log_error "Token poll request failed: $response"
            _cleanup_poll; return 2
        fi

        # Validate http_code is numeric
        if ! [[ "$http_code" =~ ^[0-9]+$ ]]; then
            log_error "Token endpoint returned invalid HTTP status: $http_code"
            _cleanup_poll; return 2
        fi

        # HTTP 5xx: server error
        if [ "$http_code" -ge 500 ]; then
            log_error "Token endpoint server error (HTTP $http_code)"
            _cleanup_poll; return 2
        fi

        # HTTP 2xx with no JSON body is unexpected
        # HTTP 4xx: parse JSON body to check for RFC 8628 error codes
        # Note: Google returns HTTP 428 for authorization_pending (non-standard)
        local token_fields
        token_fields=$(echo "$response" | jq -r '[.error // "", .id_token // ""] | @tsv' 2>/dev/null) || {
            if [ "$http_code" -ge 400 ]; then
                log_error "Token endpoint returned HTTP $http_code with non-JSON body"
                _cleanup_poll; return 2
            fi
            log_error "Token endpoint returned malformed response"
            _cleanup_poll; return 2
        }

        local error id_token
        error=$(echo "$token_fields" | cut -f1)
        id_token=$(echo "$token_fields" | cut -f2)

        if [ -z "$error" ] && [ -n "$id_token" ]; then
            _OIDC_ID_TOKEN="$id_token"
            log_debug "ID token obtained (length: ${#id_token})"
            _cleanup_poll; return 0
        fi

        case "$error" in
            authorization_pending)
                log_debug "Authorization pending, retrying in ${current_interval}s..."
                ;;
            slow_down)
                current_interval=$((current_interval + 5))
                log_debug "Server requested slow_down, new interval: ${current_interval}s"
                ;;
            access_denied)
                log_error "OIDC authorization denied by user"
                _cleanup_poll; return 3
                ;;
            expired_token)
                log_error "OIDC device code expired"
                _cleanup_poll; return 3
                ;;
            "")
                # No error but also no id_token; treat as pending
                log_debug "Token response missing both error and id_token, retrying..."
                ;;
            *)
                log_error "OIDC token error: $error (HTTP $http_code)"
                # HTTP 401/403: likely misconfigured client credentials
                if [ "$http_code" -eq 401 ] || [ "$http_code" -eq 403 ]; then
                    _cleanup_poll; return 1
                fi
                _cleanup_poll; return 3
                ;;
        esac
    done

    log_error "OIDC polling timed out waiting for authorization"
    _cleanup_poll; return 3
}

# Send ID token to CA API and save certificate + key files
# Reads _OIDC_ID_TOKEN; writes OIDC_CERT_DIR/id_oidc-cert.pub and id_oidc
oidc_get_certificate() {
    local cert_file="${OIDC_CERT_DIR}/id_oidc-cert.pub"
    local key_file="${OIDC_CERT_DIR}/id_oidc"
    local ca_endpoint="${OIDC_CA_URL%/}/ssh/sign"

    log_debug "Requesting SSH certificate from CA: $ca_endpoint"

    # Generate a new ephemeral key pair in a secure temp directory
    # Uses mktemp -d to avoid TOCTOU between file deletion and ssh-keygen
    local temp_key_dir
    temp_key_dir=$(umask 077 && mktemp -d) || {
        log_error "Failed to create temp directory for ephemeral key"
        return 1
    }
    local temp_key="$temp_key_dir/id_oidc_ephemeral"
    # Cleanup helper (cannot use trap RETURN — it would override the caller's trap)
    _cleanup_ephemeral() { rm -rf "$temp_key_dir"; }

    if ! ssh-keygen -t ed25519 -f "$temp_key" -N "" -q >/dev/null 2>&1; then
        log_error "Failed to generate ephemeral key pair"
        _cleanup_ephemeral; return 1
    fi

    local pub_key
    pub_key=$(awk '{print $2}' "${temp_key}.pub")

    # Build JSON request body safely using jq
    local json_body
    json_body=$(jq -n \
        --arg pk "$pub_key" \
        --arg ott "$_OIDC_ID_TOKEN" \
        --arg lifetime "+${OIDC_CERT_LIFETIME}s" \
        '{"publicKey":$pk,"ott":$ott,"certType":"user","validAfter":"","validBefore":$lifetime}') || {
        log_error "Failed to build CA request JSON"
        _cleanup_ephemeral; return 1
    }

    # Write JSON body to temp file to avoid cmdline exposure of ott (ID token)
    local body_file
    body_file=$(umask 077 && mktemp) || {
        log_error "Failed to create temp file for CA request"
        _cleanup_ephemeral; return 1
    }
    printf '%s' "$json_body" > "$body_file" || {
        log_error "Failed to write CA request body"
        rm -f "$body_file"; _cleanup_ephemeral; return 1
    }

    local response
    response=$(curl --silent --show-error --max-time 30 --connect-timeout 10 \
        -w '\n%{http_code}' \
        -X POST "$ca_endpoint" \
        -H "Content-Type: application/json" \
        -d @"$body_file" 2>&1)
    local curl_exit=$?
    rm -f "$body_file"

    # Extract HTTP status code (last line) and response body
    local http_code="${response##*$'\n'}"
    response="${response%$'\n'*}"

    if [ $curl_exit -ne 0 ]; then
        log_error "CA certificate request failed: $response"
        _cleanup_ephemeral; return 2
    fi

    if [ "${http_code:-0}" != "200" ] && [ "${http_code:-0}" != "201" ]; then
        log_error "CA returned HTTP $http_code: $response"
        _cleanup_ephemeral; return 2
    fi

    # Validate JSON and extract certificate in a single jq call
    local cert
    cert=$(echo "$response" | jq -re '.crt // empty' 2>/dev/null) || {
        log_error "CA returned malformed JSON or missing crt field"
        _cleanup_ephemeral; return 2
    }
    if [ -z "$cert" ]; then
        log_error "CA response missing certificate (crt field)"
        _cleanup_ephemeral; return 2
    fi

    # Ensure certificate is in OpenSSH format (type + base64)
    if ! [[ "$cert" =~ ^[a-z].*-cert- ]]; then
        # step-ca returns raw base64 wire format; derive cert type from key type
        local key_type
        key_type=$(awk '{print $1}' "${temp_key}.pub")
        if [ -n "$key_type" ]; then
            log_debug "Prepending cert type: ${key_type}-cert-v01@openssh.com"
            cert="${key_type}-cert-v01@openssh.com ${cert}"
        else
            log_error "Failed to determine key type from ${temp_key}.pub"
            _cleanup_ephemeral; return 2
        fi
    fi

    # Save private key first, then certificate — if interrupted between the two
    # writes, the fingerprint check in oidc_check_cached_cert() will detect the
    # mismatch and trigger a fresh issuance instead of using a stale pair.
    (umask 077 && cp "$temp_key" "$key_file") || {
        log_error "Failed to write key file: $key_file"
        _cleanup_ephemeral; return 2
    }
    (umask 077 && printf '%s\n' "$cert" > "$cert_file") || {
        log_error "Failed to write certificate file: $cert_file"
        rm -f "$key_file"
        _cleanup_ephemeral; return 2
    }
    chmod 600 "$cert_file" "$key_file"
    _cleanup_ephemeral

    # Validate the saved certificate is parseable by OpenSSH
    if ! ssh-keygen -L -f "$cert_file" >/dev/null 2>&1; then
        log_error "CA returned an invalid SSH certificate"
        rm -f "$cert_file" "$key_file"
        return 2
    fi

    log_debug "Certificate saved: $cert_file"
    log_debug "Key saved: $key_file"
    return 0
}

# Check if a valid cached certificate and its corresponding key exist
# Returns 0 if both exist and certificate has not expired
oidc_check_cached_cert() {
    local cert_file="${OIDC_CERT_DIR}/id_oidc-cert.pub"
    local key_file="${OIDC_CERT_DIR}/id_oidc"

    if [ ! -f "$cert_file" ] || [ ! -f "$key_file" ]; then
        log_debug "No cached OIDC certificate or key found"
        return 1
    fi

    # Verify certificate matches the private key (fingerprint comparison)
    local cert_fp key_fp
    cert_fp=$(ssh-keygen -L -f "$cert_file" 2>/dev/null | grep "Public key:" | awk '{print $NF}')
    key_fp=$(ssh-keygen -l -f "$key_file" 2>/dev/null | awk '{print $2}')
    if [ -z "$cert_fp" ] || [ -z "$key_fp" ] || [ "$cert_fp" != "$key_fp" ]; then
        log_debug "Cached certificate does not match private key (cert=$cert_fp key=$key_fp)"
        return 1
    fi

    # Extract validity end time from certificate
    local valid_to_str
    valid_to_str=$(ssh-keygen -L -f "$cert_file" 2>/dev/null | grep "Valid:" | sed 's/.*to //')
    if [ -z "$valid_to_str" ]; then
        log_debug "Cannot parse certificate validity"
        return 1
    fi

    # Handle "forever" validity (no expiry)
    if [[ "$valid_to_str" == *"forever"* ]]; then
        log_debug "Certificate valid forever"
        return 0
    fi

    # Convert to epoch seconds (macOS vs Linux)
    local valid_to_epoch
    if [[ "$OSTYPE" == "darwin"* ]]; then
        valid_to_epoch=$(date -jf "%Y-%m-%dT%H:%M:%S" "$valid_to_str" "+%s" 2>/dev/null)
    else
        valid_to_epoch=$(date -d "$valid_to_str" "+%s" 2>/dev/null)
    fi

    if [ -z "$valid_to_epoch" ]; then
        log_debug "Cannot convert certificate expiry to epoch: '$valid_to_str'"
        return 1
    fi

    local now_epoch
    now_epoch=$(date "+%s")

    if [ "$now_epoch" -lt "$valid_to_epoch" ]; then
        log_debug "Cached certificate is valid (expires at $valid_to_str)"
        return 0
    fi

    log_debug "Cached certificate has expired (expired at $valid_to_str)"
    return 1
}

# Ensure a directory exists with mode 700, rejecting symlinks
# Usage: ensure_secure_dir /path/to/dir
ensure_secure_dir() {
    local dir="$1"
    if [ -L "$dir" ]; then
        log_error "Security error: $dir is a symlink"
        return 1
    fi
    if [ ! -e "$dir" ]; then
        mkdir -m 700 "$dir" || { log_error "Failed to create $dir"; return 1; }
    elif [ -d "$dir" ]; then
        local perms
        perms=$(stat -f '%Lp' "$dir" 2>/dev/null || stat -c '%a' "$dir" 2>/dev/null)
        if [ -n "$perms" ] && [ "$perms" != "700" ]; then
            log_warn "$dir has permissions $perms (expected 700)"
        fi
    else
        log_error "$dir exists but is not a directory"
        return 1
    fi
    return 0
}

# Create certificate directory with secure permissions
# Creates ~/.ssh/ if needed (chmod 700), then OIDC_CERT_DIR (chmod 700)
ensure_oidc_cert_dir() {
    ensure_secure_dir "$HOME/.ssh" || return 1
    ensure_secure_dir "$OIDC_CERT_DIR" || return 1
    return 0
}

# Determine whether OIDC should be used for the current connection
should_use_oidc() {
    [ "$FORCE_OIDC" = true ] && return 0
    [ "$OIDC_ENABLED" = "true" ] || return 1
    case "$OIDC_AUTH_MODE" in
        only|prefer) return 0 ;;
        auto) [ ! -f "$SECURITY_KEY_PATH" ] && return 0; return 1 ;;
        disabled|*) return 1 ;;
    esac
}

# Connect using OIDC Device Flow certificate authentication
ssh_with_oidc() {
    local hostname="$1"
    local dry_run="${2:-false}"
    shift 2
    local ssh_options=("$@")

    # Sanitize hostname before writing to temp config
    if ! validate_ssh_hostname "$hostname"; then
        return 1
    fi

    local cert_file="${OIDC_CERT_DIR}/id_oidc-cert.pub"
    local key_file="${OIDC_CERT_DIR}/id_oidc"

    # 1. Check prerequisites
    check_oidc_dependencies || return 1
    validate_oidc_urls || return 1
    validate_oidc_cert_lifetime || return 1

    # 2. Prepare certificate directory
    ensure_oidc_cert_dir || return 1

    # 3. Use cached certificate if still valid
    if oidc_check_cached_cert; then
        log_info "Using cached OIDC certificate"
    else
        # 4. Run OIDC Device Flow
        oidc_discover "$OIDC_ISSUER" || return 2
        oidc_device_authorize || return 2
        oidc_poll_token || return $?
        oidc_get_certificate || return 2
        log_info "SSH certificate obtained successfully"
    fi

    # 5. Build temporary SSH config and connect
    local temp_config
    temp_config=$(umask 077 && mktemp) || return 1
    trap 'rm -f "$temp_config"' RETURN INT TERM

    # Helper to append OIDC identity lines to temp config
    _append_oidc_identity() {
        echo "    IdentityFile $key_file" >> "$temp_config"
        echo "    CertificateFile $cert_file" >> "$temp_config"
        echo "    IdentitiesOnly yes" >> "$temp_config"
        echo "    IdentityAgent none" >> "$temp_config"
    }

    # Read the config as ssh will apply it, the caller's options included: a
    # host may be defined only in a config named with -F, and its HostName /
    # User / Port have to reach the temporary config or the connection is made
    # to the wrong place.
    local ssh_g_host
    ssh_g_host=$(ssh -G "${ssh_options[@]}" -- "$hostname" 2>/dev/null)

    # Secondary lookups read the same config files but must not inherit
    # per-host overrides aimed at the target
    local proxy_jump
    proxy_jump=$(echo "$ssh_g_host" | grep "^proxyjump " | awk '{print $2}')

    if [ -n "$proxy_jump" ] && [ "$proxy_jump" != "none" ]; then
        # Sanitize proxy_jump before writing to temp config
        if ! validate_ssh_hostname "$proxy_jump"; then
            return 1
        fi
        log_debug "ProxyJump detected for OIDC: $proxy_jump"
        local ssh_g_proxy
        ssh_g_proxy=$(ssh -G "${SSH_CONFIG_OPTIONS[@]}" -- "$proxy_jump" 2>/dev/null)

        # Proxy host: offer the OIDC certificate as the primary identity so
        # a sshd configured with TrustedUserCAKeys can authenticate the user
        # via the same OIDC cert as the target — avoiding a second factor
        # on the proxy hop. Write the OIDC IdentityFile/CertificateFile
        # BEFORE the proxy's configured identityfile so OpenSSH tries the
        # cert first (ssh_config(5): IdentityFile directives are tried in
        # the order listed). Keep the proxy's configured identityfile and
        # the ssh-agent (no IdentitiesOnly / IdentityAgent none here) as
        # fallbacks for setups where the proxy does not trust the OIDC CA.
        echo "Host $proxy_jump" >> "$temp_config"
        _write_effective_config "$ssh_g_proxy" \
            identityfile identityagent identitiesonly certificatefile \
            >> "$temp_config"
        echo "    IdentityFile $key_file" >> "$temp_config"
        echo "    CertificateFile $cert_file" >> "$temp_config"
        echo "$ssh_g_proxy" | \
            grep -E "^identityfile " | \
            awk '{print "    " $1 " " $2}' >> "$temp_config"
        echo "" >> "$temp_config"

        echo "Host $hostname" >> "$temp_config"
        _write_effective_config "$ssh_g_host" \
            identityfile identityagent identitiesonly certificatefile \
            >> "$temp_config"
        _append_oidc_identity
    else
        echo "Host $hostname" >> "$temp_config"
        _write_effective_config "$ssh_g_host" \
            identityfile identityagent identitiesonly certificatefile \
            >> "$temp_config"
        _append_oidc_identity
    fi

    # Built once so the dry run cannot describe a command different from the
    # one that would run. The caller's own -F is deliberately absent: see
    # _split_ssh_config_options.
    # `--` before the destination is what actually closes the option class: ssh
    # RESUMES option parsing after the destination and keeps going until the
    # first non-option word, so a caller's -F written after the hostname would
    # otherwise still be read as an option and replace this temporary config —
    # discarding the IdentitiesOnly/IdentityAgent restrictions it exists to
    # impose. Nothing is lost: the temp config is generated from `ssh -G` output
    # that already merged the caller's -F.
    local ssh_command=(ssh -F "$temp_config" "${SSH_OTHER_OPTIONS[@]}" -- "$hostname" "${SSH_REMOTE_COMMAND[@]}")

    if [ "$dry_run" = true ]; then
        print_info "[DRY RUN] Would execute: $(render_argv "${ssh_command[@]}")"
        print_info "[DRY RUN] Temporary SSH config:"
        while IFS= read -r line; do
            print_info "  $line"
        done < "$temp_config"
        return 0
    fi

    log_debug "Executing: $(render_argv "${ssh_command[@]}")"
    "${ssh_command[@]}"
}

# Copy one host's effective configuration into the temporary config, minus the
# directives the caller is about to set itself.
#
# A denylist, not an allowlist. The allowlist this replaces had to grow every
# time somebody used a directive nobody had enumerated — ProxyCommand,
# HostKeyAlias, UserKnownHostsFile, RemoteForward, DynamicForward — and each
# omission silently changed how the connection was made or how the host was
# verified, with a host needing ProxyCommand failing outright. The settings
# come from `ssh -G`, so they are what ssh would have used anyway; the only
# ones that must not be copied are those this temporary config exists to
# override.
#
# `host` is dropped because it is not a setting: indented or not, it opens a
# new Host block and would swallow every line after it.
#
# Usage: _write_effective_config <ssh -G output> [extra key to drop ...]
_write_effective_config() {
    local ssh_g="$1"
    shift

    local drop="host"
    local key
    for key in "$@"; do
        drop="$drop|$key"
    done

    echo "$ssh_g" \
        | grep -Ev "^($drop) " \
        | awk '{printf "    %s", $1; for(i=2;i<=NF;i++) printf " %s", $i; print ""}'
}

# Split SSH options into the -F config-file selections and everything else,
# into SSH_CONFIG_OPTIONS and SSH_OTHER_OPTIONS.
#
# The two halves are needed in different places. Reading the effective config
# requires the caller's -F, since a host may be defined only there. Running the
# connection must NOT carry it: ssh takes the LAST -F, so a user's -F placed
# after the temporary config we build would replace it wholesale — discarding
# the IdentitiesOnly/IdentityAgent restrictions that are the entire reason the
# temporary config exists, and letting an ordinary on-disk key be offered on an
# external network. Nothing is lost by dropping it, because the temporary
# config is generated from `ssh -G` output that already merged it.
SSH_CONFIG_OPTIONS=()
SSH_OTHER_OPTIONS=()

# The remote command, if the caller gave one. Kept apart from the SSH options
# because ssh requires it AFTER the destination, while options go before.
SSH_REMOTE_COMMAND=()

# True when an SSH option consumes the FOLLOWING argument as its value. Needed
# to tell `-p 2222` (option plus separate value) from `host uptime` (destination
# plus remote command): both look like a bare word after a dash-argument, and
# only the arity distinguishes them.
#
# Both letter sets below are transcribed from the ssh(1) SYNOPSIS, which has two
# forms — the main one and `ssh [-Q query_option]`. Re-derive from both when
# updating; taking only the first drops -Q.
#
# The test is on the position of the option letter, not on the argument's last
# character. An attached value (-p2222, -oUser=bob) is self-contained, and its
# final byte belongs to the value: matching the tail would make -oUser=bob (ends
# in 'b') swallow the hostname that follows it.
_SSH_VALUE_OPTS='BbcDEeFIiJLlmOoPpQRSWw'
_SSH_FLAG_OPTS='46AaCfGgKkMNnqsTtVvXxYy'
_ssh_option_takes_value() {
    local opt="$1"
    case "$opt" in
        # Bare value-taking option: the value must be the next argument
        -["$_SSH_VALUE_OPTS"]) return 0 ;;
        # Bundled boolean flags ending in a value-taking letter, e.g. `ssh -vp 2222`.
        # Every character before the last must itself be a flag, or what looks
        # like a bundle is really an attached value.
        -["$_SSH_FLAG_OPTS"]*["$_SSH_VALUE_OPTS"])
            case "${opt#-}" in
                *[!"$_SSH_FLAG_OPTS"]*["$_SSH_VALUE_OPTS"]) return 1 ;;
            esac
            return 0
            ;;
    esac
    return 1
}
_split_ssh_config_options() {
    SSH_CONFIG_OPTIONS=()
    SSH_OTHER_OPTIONS=()
    local expect_path=false
    local opt
    for opt in "$@"; do
        if [ "$expect_path" = true ]; then
            expect_path=false
            SSH_CONFIG_OPTIONS+=("$opt")
            continue
        fi
        case "$opt" in
            -F)
                SSH_CONFIG_OPTIONS+=("$opt")
                expect_path=true
                ;;
            -F?*)
                SSH_CONFIG_OPTIONS+=("$opt")
                ;;
            -[!-]*F)
                # Bundled short options ending in F take the next argument,
                # e.g. `ssh -vF config`
                SSH_OTHER_OPTIONS+=("${opt%F}")
                expect_path=true
                SSH_CONFIG_OPTIONS+=("-F")
                ;;
            *)
                SSH_OTHER_OPTIONS+=("$opt")
                ;;
        esac
    done
}

# Check that the hostname can be reached — declared in ~/.ssh/config or in a
# config the SSH options bring in (Host alias), or resolvable via DNS / IP.
# Takes the SSH options the connection will use, for the same reason
# is_tailscale_host does: only ssh knows the effective set of config files.
check_ssh_config() {
    local hostname="$1"
    shift
    local ssh_options=("$@")

    if list_ssh_hosts | grep -Fx -- "$hostname" >/dev/null 2>&1; then
        return 0
    fi

    # Strip optional user@ prefix before resolving
    local target="${hostname##*@}"

    # A Host block in a config named with -F is as real as one in
    # ~/.ssh/config, and list_ssh_hosts cannot see it. ssh rewriting the
    # HostName is the evidence that some block matched.
    local effective
    effective=$(ssh -G "${ssh_options[@]}" -- "$hostname" 2>/dev/null | awk '/^hostname / {print $2}')
    if [ -n "$effective" ] && [ "$effective" != "$target" ]; then
        log_debug "Host '$hostname' configured outside ~/.ssh/config (HostName $effective)"
        return 0
    fi

    # IPv4 literal, or IPv6 literal (≥2 colons rules out host:port forms)
    if [[ "$target" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]] || [[ "$target" == *:*:* ]]; then
        return 0
    fi

    # Reachability only — nothing here selects credentials, so the OS resolver
    # (mDNS/.local, /etc/hosts) is safe to consult
    if resolve_hostname "$target" system >/dev/null 2>&1; then
        log_debug "Host '$hostname' not in SSH config; using DNS resolution"
        return 0
    fi

    echo "Warning: SSH configuration for '$hostname' not found" >&2
    return 1
}

# Connect from home (regular public key authentication)
ssh_from_home() {
    local hostname="$1"
    local dry_run="${2:-false}"
    shift 2
    local ssh_options=("$@")

    print_success "Home network connection detected. Connecting with regular public key authentication..."
    print_info "Target: $hostname"

    if [ "$dry_run" = true ]; then
        print_debug "[DRY RUN] Would execute: $(render_argv ssh "${ssh_options[@]}" -- "$hostname" "${SSH_REMOTE_COMMAND[@]}")"
        return 0
    fi

    # See the comment at the away-path exec site: `--` is what stops ssh reading
    # a post-hostname argument as an option.
    log_debug "Executing: $(render_argv ssh "${ssh_options[@]}" -- "$hostname" "${SSH_REMOTE_COMMAND[@]}")"
    ssh "${ssh_options[@]}" -- "$hostname" "${SSH_REMOTE_COMMAND[@]}"
}

# Connect from away (security key authentication)
ssh_from_away() {
    local hostname="$1"
    local dry_run="${2:-false}"
    shift 2
    local ssh_options=("$@")

    # Sanitize hostname before writing to temp config
    if ! validate_ssh_hostname "$hostname"; then
        return 1
    fi

    # Check if security key file exists
    if [ ! -f "$SECURITY_KEY_PATH" ]; then
        print_error "Error: Security key file not found: $SECURITY_KEY_PATH"
        echo ""
        echo "Please generate a security key first:"
        echo "  ssh-keygen -t ed25519-sk -f $SECURITY_KEY_PATH"
        echo "  ssh-keygen -t ecdsa-sk -f $SECURITY_KEY_PATH"
        echo ""
        echo "Or specify a different key using environment variable:"
        echo "  SECURITY_KEY_PATH=~/.ssh/id_ecdsa_sk smart-ssh --security-key production"
        exit 1
    fi

    print_warning "External network detected. Connecting with security key authentication..."
    print_warning "Please touch your YubiKey or security key when prompted."
    print_info "Target: $hostname (using $SECURITY_KEY_PATH)"

    # Create temporary SSH config that only uses the security key
    local temp_config
    temp_config=$(umask 077 && mktemp)
    trap 'rm -f "$temp_config"' RETURN

    # Helper to append security key identity lines to temp config
    _append_sk_identity() {
        echo "    IdentityFile $SECURITY_KEY_PATH" >> "$temp_config"
        echo "    IdentitiesOnly yes" >> "$temp_config"
        echo "    IdentityAgent none" >> "$temp_config"
    }

    # Read the config as ssh will apply it, the caller's options included: a
    # host may be defined only in a config named with -F, and its HostName /
    # User / Port have to reach the temporary config or the connection is made
    # to the wrong place. Cached to avoid repeated invocations.
    local ssh_g_host
    ssh_g_host=$(ssh -G "${ssh_options[@]}" -- "$hostname" 2>/dev/null)

    local proxy_jump
    proxy_jump=$(echo "$ssh_g_host" | grep "^proxyjump " | awk '{print $2}')

    # If ProxyJump is configured, add the proxy host configuration first
    if [ -n "$proxy_jump" ] && [ "$proxy_jump" != "none" ]; then
        # Sanitize proxy_jump before writing to temp config
        if ! validate_ssh_hostname "$proxy_jump"; then
            return 1
        fi
        log_debug "ProxyJump detected: $proxy_jump"
        local ssh_g_proxy
        ssh_g_proxy=$(ssh -G "${SSH_CONFIG_OPTIONS[@]}" -- "$proxy_jump" 2>/dev/null)

        # Add proxy host configuration with security key
        echo "Host $proxy_jump" >> "$temp_config"
        _write_effective_config "$ssh_g_proxy" \
            identityfile identityagent identitiesonly certificatefile \
            >> "$temp_config"
        _append_sk_identity
        echo "" >> "$temp_config"

        # Add target host configuration (keep original IdentityFile for final destination)
        echo "Host $hostname" >> "$temp_config"
        # identityfile is deliberately kept here: the final destination keeps
        # its own key, only the proxy hop is pinned to the security key
        _write_effective_config "$ssh_g_host" \
            identityagent identitiesonly certificatefile \
            >> "$temp_config"
        echo "    IdentitiesOnly yes" >> "$temp_config"
    else
        # No ProxyJump - direct connection with security key
        # Check if hostname references another Host alias
        local target_hostname
        target_hostname=$(echo "$ssh_g_host" | grep "^hostname " | awk '{print $2}')

        # Sanitize target_hostname before use
        if [ -n "$target_hostname" ] && ! validate_ssh_hostname "$target_hostname"; then
            return 1
        fi

        # If target_hostname is a Host alias (not a FQDN/IP), resolve it
        local is_alias=false
        local ssh_g_target=""
        if [ -n "$target_hostname" ] && [ "$target_hostname" != "$hostname" ]; then
            ssh_g_target=$(ssh -G "${SSH_CONFIG_OPTIONS[@]}" -- "$target_hostname" 2>/dev/null)
            local alias_hostname
            alias_hostname=$(echo "$ssh_g_target" | grep "^hostname " | awk '{print $2}')
            # Sanitize alias_hostname before use
            if [ -n "$alias_hostname" ] && ! validate_ssh_hostname "$alias_hostname"; then
                return 1
            fi
            # Check if the alias resolves to a different hostname (meaning it's a Host entry)
            if [ -n "$alias_hostname" ] && [ "$alias_hostname" != "$target_hostname" ]; then
                log_debug "HostName alias detected: $target_hostname -> $alias_hostname"
                is_alias=true
                # Add the alias host configuration
                echo "Host $target_hostname" >> "$temp_config"
                _write_effective_config "$ssh_g_target" \
                    identityfile identityagent identitiesonly certificatefile \
                    >> "$temp_config"
                _append_sk_identity
                echo "" >> "$temp_config"
            fi
        fi

        echo "Host $hostname" >> "$temp_config"
        if [ "$is_alias" = true ]; then
            # Use settings from the alias host, plus localforward from original
            # Use the resolved hostname (FQDN/IP), not the alias
            echo "    hostname $alias_hostname" >> "$temp_config"
            # Only the alias's connection identity is taken from it, and it
            # goes first because ssh keeps the FIRST value of a setting — the
            # requested name's defaults (port 22, the local user) would
            # otherwise win over the alias's own. Everything else comes from
            # the name the user actually asked for: copying the alias wholesale
            # would put ITS defaults ahead of that name's explicit settings, so
            # a StrictHostKeyChecking or ProxyCommand set on the requested host
            # would be silently replaced by the alias's default.
            echo "$ssh_g_target" \
                | grep -E "^(user|port) " \
                | awk '{print "    " $1 " " $2}' >> "$temp_config"
            _write_effective_config "$ssh_g_host" \
                hostname identityfile identityagent identitiesonly certificatefile \
                >> "$temp_config"
        else
            _write_effective_config "$ssh_g_host" \
                identityfile identityagent identitiesonly certificatefile \
                >> "$temp_config"
        fi
        _append_sk_identity
    fi

    # Built once so the dry run cannot describe a command different from the
    # one that would run. The caller's own -F is deliberately absent: see
    # _split_ssh_config_options.
    # `--` before the destination is what actually closes the option class: ssh
    # RESUMES option parsing after the destination and keeps going until the
    # first non-option word, so a caller's -F written after the hostname would
    # otherwise still be read as an option and replace this temporary config —
    # discarding the IdentitiesOnly/IdentityAgent restrictions it exists to
    # impose. Nothing is lost: the temp config is generated from `ssh -G` output
    # that already merged the caller's -F.
    local ssh_command=(ssh -F "$temp_config" "${SSH_OTHER_OPTIONS[@]}" -- "$hostname" "${SSH_REMOTE_COMMAND[@]}")

    if [ "$dry_run" = true ]; then
        print_info "[DRY RUN] Would execute: $(render_argv "${ssh_command[@]}")"
        print_info "[DRY RUN] Temporary SSH config:"
        while IFS= read -r line; do
            print_info "  $line"
        done < "$temp_config"
        return 0
    fi

    log_debug "Executing: $(render_argv "${ssh_command[@]}")"
    "${ssh_command[@]}"
}

# Main function
main() {
    local hostname=""
    local hostname_set=false
    local force_security_key=false
    local dry_run=false
    FORCE_OIDC=false
    local ssh_options=()
    SSH_REMOTE_COMMAND=()

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        # The hostname is the boundary: everything after the destination is
        # the remote command. This runs before the case below because
        # smart-ssh's own --help/-d would otherwise capture
        # `smart-ssh host --help`, which the user means to run on the remote,
        # and -*) would hoist a dash-leading command ahead of the destination.
        # ssh does NOT stop at the destination by itself, which is why the exec
        # sites pass `--`; this guard only decides what smart-ssh collects.
        if [ "$hostname_set" = true ]; then
            SSH_REMOTE_COMMAND=("$@")
            break
        fi
        case $1 in
            --security-key|-s)
                force_security_key=true
                shift
                ;;
            --dry-run|-n)
                dry_run=true
                shift
                ;;
            --init-config)
                init_config
                exit $?
                ;;
            --debug|-d)
                debug_info
                exit 0
                ;;
            --help|-h)
                usage
                exit 0
                ;;
            --version)
                echo "smart-ssh $VERSION"
                exit 0
                ;;
            --oidc)
                FORCE_OIDC=true
                shift
                ;;
            --)
                # End of smart-ssh options. What follows is for ssh, but it may
                # still contain the hostname (documented as `-- host -v`), and
                # anything after that hostname is the remote command.
                shift
                while [[ $# -gt 0 ]]; do
                    # The hostname ends option parsing here too. Testing for a
                    # dash first would let `-- host -oProxyCommand=...` move an
                    # option the user wrote as remote-command text back ahead of
                    # the destination, where ssh executes it locally.
                    if [ "$hostname_set" = true ]; then
                        SSH_REMOTE_COMMAND=("$@")
                        break
                    fi
                    if [[ "$1" == -* ]]; then
                        ssh_options+=("$1")
                        if _ssh_option_takes_value "$1" && [ $# -gt 1 ]; then
                            ssh_options+=("$2")
                            shift
                        fi
                        shift
                    else
                        hostname="$1"
                        hostname_set=true
                        shift
                    fi
                done
                break
                ;;
            -*)
                # Options taking a separate value (`-p 2222`, `-F path`) must
                # swallow that value here, or the loop below would mistake it for
                # the remote command.
                ssh_options+=("$1")
                if _ssh_option_takes_value "$1" && [ $# -gt 1 ]; then
                    ssh_options+=("$2")
                    shift
                fi
                shift
                ;;
            *)
                # First non-option argument is hostname
                if [ "$hostname_set" = false ]; then
                    hostname="$1"
                    hostname_set=true
                    shift
                else
                    # Everything after the hostname is the remote command. ssh
                    # itself stops parsing options there, so it must not be
                    # mixed into ssh_options: those are placed BEFORE the
                    # hostname, where ssh would read the command's first word
                    # as the destination instead.
                    SSH_REMOTE_COMMAND=("$@")
                    break
                fi
                ;;
        esac
    done

    if [ "$hostname_set" = false ] || [ -z "$hostname" ]; then
        print_error "Error: Please specify a hostname"
        usage
        exit 1
    fi

    # Separate the caller's -F from the rest once, for every path below
    _split_ssh_config_options "${ssh_options[@]}"

    # Check SSH configuration exists
    if ! check_ssh_config "$hostname" "${ssh_options[@]}"; then
        echo ""
        echo "Example SSH configuration:"
        echo "# ~/.ssh/config"
        echo "Host $hostname"
        echo "    HostName your-server.example.com"
        echo "    User your-username"
        echo "    IdentityFile ~/.ssh/id_ed25519"
        echo ""
        echo "Note: Security key ($SECURITY_KEY_PATH) will be used automatically"
        echo "      when connecting from external networks."
        exit 1
    fi

    # Force security key if requested
    if [ "$force_security_key" = true ]; then
        print_warning "Security key authentication forced by --security-key option"
        ssh_from_away "$hostname" "$dry_run" "${ssh_options[@]}"
        return
    fi

    # Force OIDC if requested (skip network detection)
    if [ "$FORCE_OIDC" = true ]; then
        print_warning "OIDC authentication forced by --oidc option"
        local oidc_exit_code=0
        ssh_with_oidc "$hostname" "$dry_run" "${ssh_options[@]}" || oidc_exit_code=$?
        if [ "$oidc_exit_code" -ne 0 ]; then
            log_error "OIDC authentication failed (exit $oidc_exit_code)"
            exit "$oidc_exit_code"
        fi
        return
    fi

    print_info "Checking local network..."

    # Detection priority: Tailscale (destination) > Gateway MAC > IP address
    local is_home=false
    local detection_method=""
    local detected_value=""

    # Try Tailscale destination detection first (if enabled)
    if [ "$TAILSCALE_AS_HOME" = "true" ]; then
        if is_tailscale_host "$hostname" "${ssh_options[@]}"; then
            is_home=true
            detection_method="Tailscale"
            detected_value="$TAILSCALE_RESOLVED_HOST"

            # Connect to the address the daemon vouched for. Letting ssh resolve
            # the name again would hand the choice back to the system resolver,
            # which is the attacker's whenever Tailscale is not managing DNS —
            # the verdict would then be about one host and the on-disk key would
            # be presented to another.
            #
            # PREPENDED, not appended: ssh takes the first value of an option,
            # so anything added after the caller's own arguments loses to a
            # `-o HostName=...` among them and the pin would be decorative.
            local pin=(-o "HostName=$TAILSCALE_PEER_IP")
            if [ -n "$TAILSCALE_HOST_KEY_ALIAS" ]; then
                # Keeps known_hosts keyed on the name, so pinning the address
                # costs no host-key prompts. Skipped when the config sets its
                # own HostKeyAlias, which must stay authoritative.
                pin+=(-o "HostKeyAlias=$TAILSCALE_HOST_KEY_ALIAS")
            fi
            ssh_options=("${pin[@]}" "${ssh_options[@]}")
            log_debug "Pinning connection to verified tailnet address $TAILSCALE_PEER_IP"
        fi
    fi

    # Try Gateway MAC detection (if configured and not already detected)
    if [ -z "$detection_method" ] && [ -n "$HOME_GATEWAY_MAC" ]; then
        local current_mac
        current_mac=$(get_gateway_mac)
        if [ -n "$current_mac" ]; then
            log_debug "Gateway MAC: $current_mac"
            if is_home_gateway_mac "$current_mac"; then
                is_home=true
                detection_method="Gateway MAC"
                detected_value="$current_mac"
            else
                detection_method="Gateway MAC"
                detected_value="$current_mac"
            fi
        else
            log_debug "Cannot get gateway MAC, falling back to IP detection"
        fi
    fi

    # Fall back to IP-based detection
    if [ -z "$detection_method" ]; then
        CURRENT_IP=$(get_current_ip)
        log_debug "Current IP: $CURRENT_IP"

        if [ "$CURRENT_IP" = "NOT_CONNECTED" ]; then
            print_warning "Cannot determine network."

            if [ "$dry_run" = true ]; then
                print_debug "[DRY RUN] Manual selection would be required"
                print_debug "[DRY RUN] Options:"
                if [ ${#ssh_options[@]} -gt 0 ]; then
                    print_debug "  1) Regular public key: ssh ${ssh_options[*]} $hostname"
                    print_debug "  2) Security key: ssh -i $SECURITY_KEY_PATH ${ssh_options[*]} $hostname"
                else
                    print_debug "  1) Regular public key: ssh $hostname"
                    print_debug "  2) Security key: ssh -i $SECURITY_KEY_PATH $hostname"
                fi
                return 0
            fi

            echo "Please manually select SSH connection method:"
            echo "1) Regular public key authentication ($hostname)"
            echo "2) Security key authentication ($hostname using $SECURITY_KEY_PATH)"
            read -rp "Choice (1/2): " choice

            case $choice in
                1) ssh_from_home "$hostname" "$dry_run" "${ssh_options[@]}" ;;
                2) ssh_from_away "$hostname" "$dry_run" "${ssh_options[@]}" ;;
                *) print_error "Invalid choice."; exit 1 ;;
            esac
            return
        fi

        if is_home_network "$CURRENT_IP"; then
            is_home=true
        fi
        detection_method="IP"
        detected_value="$CURRENT_IP"
    fi

    # Connect based on detection result
    if [ "$is_home" = true ]; then
        print_success "Home network detected ($detection_method: $detected_value)"
        ssh_from_home "$hostname" "$dry_run" "${ssh_options[@]}"
    else
        print_warning "External network detected ($detection_method: $detected_value)"
        if should_use_oidc; then
            local oidc_exit_code=0
            ssh_with_oidc "$hostname" "$dry_run" "${ssh_options[@]}" || oidc_exit_code=$?

            if [ "$oidc_exit_code" -ne 0 ]; then
                # --oidc / only / auto: no fallback
                if [ "$FORCE_OIDC" = true ] || [ "$OIDC_AUTH_MODE" = "only" ] || [ "$OIDC_AUTH_MODE" = "auto" ]; then
                    log_error "OIDC authentication failed (exit $oidc_exit_code)"
                    exit "$oidc_exit_code"
                fi
                # prefer: fall back to sk key only on network/CA error (exit 2)
                if [ "$OIDC_AUTH_MODE" = "prefer" ] && [ "$oidc_exit_code" -eq 2 ]; then
                    log_warn "OIDC network/CA error, falling back to security key"
                    ssh_from_away "$hostname" "$dry_run" "${ssh_options[@]}"
                else
                    log_error "OIDC authentication failed (exit $oidc_exit_code)"
                    exit "$oidc_exit_code"
                fi
            fi
        else
            ssh_from_away "$hostname" "$dry_run" "${ssh_options[@]}"
        fi
    fi
}

# Show debug information
debug_info() {
    echo "=== Debug Information ==="
    echo ""
    echo "Configuration:"
    echo "  Config file: $CONFIG_FILE"
    echo "  Config file exists: $([ -f "$CONFIG_FILE" ] && echo "Yes" || echo "No")"
    echo "  TAILSCALE_AS_HOME: $TAILSCALE_AS_HOME"
    echo "  Tailscale CLI: $(command -v tailscale >/dev/null 2>&1 && echo 'available' || echo 'not found')"
    if command -v tailscale >/dev/null 2>&1; then
        echo "  Tailscale daemon: $(tailscale status >/dev/null 2>&1 && echo 'running' || echo 'not running')"
    fi
    echo "  HOME_GATEWAY_MAC: ${HOME_GATEWAY_MAC:-<not configured>}"
    echo "  HOME_NETWORK: $HOME_NETWORK"
    echo "  SECURITY_KEY_PATH: $SECURITY_KEY_PATH"
    echo "  LOG_LEVEL: $LOG_LEVEL"
    echo ""
    echo "Network:"
    echo "  Gateway IP: $(get_gateway_ip)"
    echo "  Gateway MAC: $(get_gateway_mac || echo 'N/A')"
    echo "  Current IP: $(get_current_ip)"
    echo "  Security key file exists: $([ -f "$SECURITY_KEY_PATH" ] && echo "Yes" || echo "No")"
    echo ""
    echo "Network connection status:"
    
    # Show platform-specific network info
    if grep -qi "microsoft.*wsl\|wsl.*microsoft" /proc/version 2>/dev/null || command -v powershell.exe >/dev/null 2>&1; then
        echo "WSL2 detected - showing Windows host network info:"
        powershell.exe -Command "Get-NetAdapter | Where-Object {\$_.Status -eq 'Up'} | Select-Object Name,InterfaceDescription" 2>/dev/null
        powershell.exe -Command "Get-NetIPAddress -AddressFamily IPv4 | Where-Object {\$_.InterfaceAlias -like '*Wi-Fi*'} | Select-Object IPAddress,InterfaceAlias" 2>/dev/null
    elif command -v ip >/dev/null 2>&1; then
        ip addr show | grep -E "(inet |UP,)"
    elif [[ "$OSTYPE" == "darwin"* ]]; then
        ifconfig | grep -E "(flags=|inet )" | grep -A1 "UP," | grep "inet "
    fi
    
    echo ""
    echo "OIDC:"
    echo "  OIDC_ENABLED: $OIDC_ENABLED"
    echo "  OIDC_ISSUER: ${OIDC_ISSUER:-<not configured>}"
    # Mask client ID: show first 8 chars only
    if [ -n "$OIDC_CLIENT_ID" ]; then
        echo "  OIDC_CLIENT_ID: ${OIDC_CLIENT_ID:0:8}..."
    else
        echo "  OIDC_CLIENT_ID: <not configured>"
    fi
    if [ -n "$OIDC_CLIENT_SECRET" ]; then
        echo "  OIDC_CLIENT_SECRET: ********"
    else
        echo "  OIDC_CLIENT_SECRET: <not configured>"
    fi
    echo "  OIDC_CA_URL: ${OIDC_CA_URL:-<not configured>}"
    echo "  OIDC_AUTH_MODE: $OIDC_AUTH_MODE"
    echo "  OIDC_CERT_DIR: $OIDC_CERT_DIR"
    # Show cached certificate status
    local cert_file="${OIDC_CERT_DIR}/id_oidc-cert.pub"
    local key_file="${OIDC_CERT_DIR}/id_oidc"
    if [ -f "$cert_file" ] && [ -f "$key_file" ]; then
        if oidc_check_cached_cert 2>/dev/null; then
            echo "  Cached certificate: present (valid)"
        else
            echo "  Cached certificate: present (expired)"
        fi
    else
        echo "  Cached certificate: none"
    fi
    echo "  jq available: $(command -v jq >/dev/null 2>&1 && echo "Yes" || echo "No")"
    echo "  ID token: (never shown)"
    echo ""
    echo "SSH configuration check:"
    if [ -f ~/.ssh/config ]; then
        echo "$HOME/.ssh/config exists"
        echo "Available host entries (including Include directives):"

        list_ssh_hosts | head -20 || echo "  No Host entries found"
    else
        echo "$HOME/.ssh/config does not exist"
    fi
    echo "========================="
}

# Handle options and arguments.
# No arguments at all is a usage request; an empty FIRST argument is not — that
# is a caller bug (an unset variable), and it must reach main's hostname check
# rather than being answered with usage and a success exit.
if [ $# -eq 0 ]; then
    usage
    exit 0
fi

case "$1" in
    --list-hosts)
        list_ssh_hosts
        ;;
    --debug|-d)
        debug_info
        ;;
    --help|-h)
        usage
        ;;
    --version)
        echo "smart-ssh $VERSION"
        ;;
    --oidc)
        main "$@"
        ;;
    *)
        main "$@"
        ;;
esac
